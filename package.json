{
  "name": "interview-ax-lite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-highs.mjs",
    "predev": "node scripts/copy-highs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-highs.mjs",
    "build": "tsc -b && vite build",
